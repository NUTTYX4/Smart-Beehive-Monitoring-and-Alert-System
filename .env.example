# BeeHive Monitor — Environment Variables
# =========================================
# Copy this file to .env and fill in real values.
# The app reads these via environment variables (see config.py).
#
# On the Raspberry Pi, set these in the systemd override instead:
#   sudo nano /etc/systemd/system/beehive.service.d/override.conf
#
# NEVER commit a .env file with real credentials to version control.

# ----- Telegram -------------------------------------------------------
BEEHIVE_TELEGRAM_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN
BEEHIVE_ADMIN_ID=REPLACE_WITH_YOUR_NUMERIC_TELEGRAM_USER_ID
BEEHIVE_CHANNEL=@YourChannelUsername
BEEHIVE_CHANNEL_LINK=https://t.me/YourChannelUsername

# ----- ThingSpeak -----------------------------------------------------
# Channel 1: temperature, humidity, motion
BEEHIVE_TS_ENV_KEY=REPLACE_WITH_ENV_MOTION_WRITE_KEY
# Channel 2: weight, audio frequency
BEEHIVE_TS_WA_KEY=REPLACE_WITH_WEIGHT_AUDIO_WRITE_KEY

# ----- GPIO pins (defaults match README wiring) -----------------------
# BEEHIVE_HX711_DOUT=5
# BEEHIVE_HX711_SCK=6
# BEEHIVE_DHT22_PIN=4
# BEEHIVE_MPU_I2C_BUS=1
# BEEHIVE_MPU_ADDR=104

# ----- INMP441 I2S microphone -----------------------------------------
# BEEHIVE_MIC_SAMPLE_RATE=44100
# BEEHIVE_MIC_CHANNELS=1
# BEEHIVE_MIC_DEVICE=
# BEEHIVE_MIC_CAPTURE_SECONDS=2.0

# ----- Alert thresholds -----------------------------------------------
# BEEHIVE_ALERT_TEMP_HIGH=36.0
# BEEHIVE_ALERT_TEMP_LOW=30.0
# BEEHIVE_ALERT_HUMID_LOW=40.0
# BEEHIVE_ALERT_HUMID_HIGH=70.0

# ----- Logging --------------------------------------------------------
# BEEHIVE_LOG_LEVEL=INFO
