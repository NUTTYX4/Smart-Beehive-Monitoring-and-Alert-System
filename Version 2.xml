                <!-- 3. HX711 Weight Table -->
                <div class="bg-slate-900 rounded-2xl border border-slate-800 overflow-hidden shadow-xl flex flex-col justify-between">
                    <div class="bg-slate-800/60 px-6 py-4 border-b border-slate-700/80 flex items-center justify-between">
                        <h3 class="text-base font-bold text-amber-300 flex items-center gap-2">
                            <i class="fas fa-balance-scale text-amber-400"></i> HX711 Scale Telemetry
                        </h3>
                        <span class="text-xs font-semibold text-slate-400">GPIO 5 & 6</span>
