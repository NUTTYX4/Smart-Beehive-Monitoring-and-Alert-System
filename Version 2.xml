                    <div>
                        <h3 class="font-bold text-white text-base">Telemetry Data Filter</h3>
                        <p class="text-xs text-slate-400">Adjust depth of historical rows loaded from cloud logs</p>
                    </div>
                </div>
                <div class="flex items-center w-full sm:w-auto bg-slate-950/80 px-5 py-3 rounded-xl border border-slate-800/90 gap-4">
                    <label for="rowRange" class="text-sm font-semibold text-slate-300 whitespace-nowrap">Show history:</label>
                    <input type="range" id="rowRange" min="1" max="25" value="10" step="1" 
                           class="w-full sm:w-48"
                           oninput="updateSliderValue(this.value)">
                    <div class="min-w-[4.5rem] text-right">
