    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800/80 mt-16 py-8 text-center text-slate-500 text-xs sm:text-sm bg-slate-900/40">
        <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row justify-between items-center gap-4">
            <p class="flex items-center gap-2">
                <span>🐝 Smart Beehive Monitoring & Alert System — NASSCOM 2026 Edition</span>
            </p>
            <div class="flex items-center space-x-4 text-xs">
                <span class="px-2.5 py-1 rounded-md bg-slate-800 text-slate-400 border border-slate-700">Channel 1: 3442110</span>
                <span class="px-2.5 py-1 rounded-md bg-slate-800 text-slate-400 border border-slate-700">Channel 2: 3442111</span>
                <a href="https://thingspeak.com" target="_blank" class="text-amber-400 hover:underline font-semibold flex items-center gap-1">ThingSpeak Cloud <i class="fas fa-external-link-alt text-[10px]"></i></a>
            </div>
        </div>
    </footer>

    <script>
        // --- GLOBAL DATA STORE ---
        let globalFeeds1 = [];
        let globalFeeds2 = [];
        
        // --- TABS LOGIC ---
        function switchTab(tabName) {
            document.getElementById('view-charts').classList.remove('active');
            document.getElementById('view-tables').classList.remove('active');
            
            document.getElementById('btn-charts').className = "px-5 py-2 rounded-lg text-sm font-semibold transition-all duration-200 text-slate-400 hover:text-white hover:bg-slate-800 flex items-center gap-2";
            document.getElementById('btn-tables').className = "px-5 py-2 rounded-lg text-sm font-semibold transition-all duration-200 text-slate-400 hover:text-white hover:bg-slate-800 flex items-center gap-2";

            document.getElementById('view-' + tabName).classList.add('active');
            document.getElementById('btn-' + tabName).className = "px-5 py-2 rounded-lg text-sm font-semibold transition-all duration-200 bg-amber-500 text-slate-950 shadow-md shadow-amber-500/20 flex items-center gap-2";
        }

        // --- SLIDER LOGIC ---
        function updateSliderValue(val) {
            document.getElementById('sliderValue').innerText = val;
            renderTables(globalFeeds1, globalFeeds2, parseInt(val));
        }

        // --- BEHAVIOR CLASSIFIER HELPER ---
        function classifyAcoustics(freq) {
            const f = parseFloat(freq);
            if (isNaN(f) || f <= 0) return { label: "⚪ Silence", color: "bg-slate-800 text-slate-400 border-slate-700" };
            if (f > 450) return { label: "⚔️ Aggressive / Swarming", color: "bg-red-950/80 text-red-300 border-red-700 font-bold" };
            if (f >= 330 && f <= 450) return { label: "👑 Queen Piping", color: "bg-amber-950/80 text-amber-300 border-amber-600 font-bold" };
            if (f >= 190 && f < 330) return { label: "🟢 Normal / Active", color: "bg-emerald-950/80 text-emerald-300 border-emerald-700 font-bold" };
            if (f >= 100 && f < 190) return { label: "🆘 Queenless Roar", color: "bg-rose-950/80 text-rose-300 border-rose-700 font-bold" };
            if (f > 0 && f < 100) return { label: "💤 Dormant / Low", color: "bg-blue-950/80 text-blue-300 border-blue-700" };
            return { label: "⚪ Standby", color: "bg-slate-800 text-slate-400 border-slate-700" };
        }

        // --- DATA FETCHING ---
        const CH1_URL = "https://api.thingspeak.com/channels/3442110/feeds.json?api_key=FO1XVYZQTKHTAZ9K&results=25";
        const CH2_URL = "https://api.thingspeak.com/channels/3442111/feeds.json?api_key=LEVD71XJS28RQZQJ&results=25";

        Chart.defaults.color = '#94a3b8';
        Chart.defaults.borderColor = '#1e293b';
        Chart.defaults.font.family = "'Inter', system-ui, sans-serif";
        let chartInstances = {};

        async function fetchAllData() {
            const loader = document.getElementById('loading');
            loader.classList.remove('hidden');

            try {
                const [res1, res2] = await Promise.all([fetch(CH1_URL), fetch(CH2_URL)]);
                const data1 = await res1.json();
                const data2 = await res2.json();

                globalFeeds1 = data1.feeds || [];
                globalFeeds2 = data2.feeds || [];

                // Update KPI Snapshot Cards with latest data
                if (globalFeeds1.length > 0) {
                    const latest1 = globalFeeds1[globalFeeds1.length - 1];
                    document.getElementById('kpi-temp').innerText = (latest1.field1 || '--') + " °C";
                    document.getElementById('kpi-humidity').innerText = (latest1.field2 || '--') + " %";
                }
                if (globalFeeds2.length > 0) {
                    const latest2 = globalFeeds2[globalFeeds2.length - 1];
                    document.getElementById('kpi-weight').innerText = (latest2.field1 ? parseFloat(latest2.field1).toFixed(1) : '--') + " g";
                    
                    const freqVal = latest2.field3 || '0.00';
                    document.getElementById('kpi-freq').innerText = parseFloat(freqVal).toFixed(1) + " Hz";
                    const status = classifyAcoustics(freqVal);
                    const badge = document.getElementById('kpi-badge');
                    badge.innerText = status.label.replace(/^[^\s]+\s/, ''); // clean emoji for compact badge
                    badge.className = `px-2.5 py-1 text-xs rounded-md border ${status.color}`;
                }

                updateCharts(globalFeeds1, globalFeeds2);
                
                const currentLimit = document.getElementById('rowRange').value;
                renderTables(globalFeeds1, globalFeeds2, parseInt(currentLimit));

            } catch (err) {
                console.error("Error fetching data:", err);
            } finally {
                loader.classList.add('hidden');
            }
        }

        // --- TABLE RENDERER ---
        function renderTables(feeds1, feeds2, limit) {
            const dhtBody = document.getElementById('table-dht-body');
            const hxBody = document.getElementById('table-hx-body');
            const maxBody = document.getElementById('table-max-body');
            const mpuBody = document.getElementById('table-mpu-body');
            
            dhtBody.innerHTML = '';
            hxBody.innerHTML = '';
            maxBody.innerHTML = '';
            mpuBody.innerHTML = '';

            const slice1 = [...feeds1].reverse().slice(0, limit);
            const slice2 = [...feeds2].reverse().slice(0, limit);

            // 1. DHT22 (Channel 1: Field 1 & 2)
            slice1.forEach(f => {
                const date = new Date(f.created_at).toLocaleTimeString([], {month:'short', day:'numeric', hour: '2-digit', minute:'2-digit', second:'2-digit'});
                const row = `
                    <tr class="hover:bg-slate-800/70 transition">
                        <td class="px-6 py-3 text-slate-400">${date}</td>
                        <td class="px-6 py-3 font-bold text-rose-300 text-sm">${f.field1 || '-'} °C</td>
                        <td class="px-6 py-3 font-bold text-blue-300 text-sm">${f.field2 || '-'} %</td>
                    </tr>`;
                dhtBody.insertAdjacentHTML('beforeend', row);
            });

            // 2. INMP441 Acoustic AI (Channel 2: Field 3)
            slice2.forEach(f => {
                const date = new Date(f.created_at).toLocaleTimeString([], {month:'short', day:'numeric', hour: '2-digit', minute:'2-digit', second:'2-digit'});
                const freq = f.field3 ? parseFloat(f.field3).toFixed(1) + ' Hz' : '-';
                const classification = classifyAcoustics(f.field3);
                const row = `
                    <tr class="hover:bg-slate-800/70 transition">
                        <td class="px-5 py-3 text-slate-400">${date}</td>
                        <td class="px-5 py-3 font-bold text-purple-300 text-sm">${freq}</td>
                        <td class="px-5 py-3"><span class="px-2.5 py-1 rounded border text-xs ${classification.color}">${classification.label}</span></td>
                    </tr>`;
                maxBody.insertAdjacentHTML('beforeend', row);
            });

            // 3. HX711 (Channel 2: Field 1)
            slice2.forEach(f => {
                const date = new Date(f.created_at).toLocaleTimeString([], {month:'short', day:'numeric', hour: '2-digit', minute:'2-digit', second:'2-digit'});
                const weight = f.field1 ? parseFloat(f.field1).toFixed(2) : null;
                const statusBadge = weight !== null ? 
                    (weight < 0 ? '<span class="text-red-400">Check Zero</span>' : '<span class="text-emerald-400">Nominal</span>') : '-';
                const row = `
                    <tr class="hover:bg-slate-800/70 transition">
                        <td class="px-6 py-3 text-slate-400">${date}</td>
                        <td class="px-6 py-3 font-bold text-amber-300 text-sm">${weight !== null ? weight + ' g' : '-'}</td>
                        <td class="px-6 py-3 font-sans text-xs">${statusBadge}</td>
                    </tr>`;
                hxBody.insertAdjacentHTML('beforeend', row);
            });

            // 4. MPU6050 (Channel 1: Fields 3,4,5,6,7,8)
            slice1.forEach(f => {
                const date = new Date(f.created_at).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit', second:'2-digit'});
                const row = `
                    <tr class="hover:bg-slate-800/70 transition">
                        <td class="px-4 py-3 text-slate-400 text-[11px]">${date}</td>
                        <td class="px-3 py-3 text-rose-300">${f.field3 || '-'}</td>
                        <td class="px-3 py-3 text-emerald-300">${f.field4 || '-'}</td>
                        <td class="px-3 py-3 font-bold text-blue-300">${f.field5 || '-'}</td>
                        <td class="px-3 py-3 text-amber-300/80">${f.field6 || '-'}</td>
                        <td class="px-3 py-3 text-amber-300/80">${f.field7 || '-'}</td>
                        <td class="px-3 py-3 text-amber-300/80">${f.field8 || '-'}</td>
                    </tr>`;
                mpuBody.insertAdjacentHTML('beforeend', row);
            });
        }

        // --- CHART RENDERER ---
        function formatTime(ts) {
            return new Date(ts).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit', second: '2-digit'});
        }

        function updateCharts(feeds1, feeds2) {
            const labels1 = feeds1.map(f => formatTime(f.created_at));
            const labels2 = feeds2.map(f => formatTime(f.created_at));

            renderChart('weightChart', labels2, [{
                label: 'Weight (Grams)',
                data: feeds2.map(f => f.field1),
                borderColor: '#f59e0b',
                backgroundColor: 'rgba(245, 158, 11, 0.1)',
                borderWidth: 2.5,
                fill: true, tension: 0.35, pointRadius: 3, pointHoverRadius: 6
            }]);

            renderChart('freqChart', labels2, [{
                label: 'Dominant Frequency (Hz)',
                data: feeds2.map(f => f.field3),
                borderColor: '#c084fc',
                backgroundColor: 'rgba(192, 132, 252, 0.12)',
                borderWidth: 2.5,
                fill: true, tension: 0.35, pointRadius: 3, pointHoverRadius: 6
            }]);

            renderChart('climateChart', labels1, [
                { label: 'Temp (°C)', data: feeds1.map(f => f.field1), borderColor: '#fb7185', borderWidth: 2.5, yAxisID: 'y', tension: 0.3, pointRadius: 2 },
                { label: 'Humidity (%)', data: feeds1.map(f => f.field2), borderColor: '#60a5fa', borderWidth: 2.5, yAxisID: 'y1', tension: 0.3, pointRadius: 2 }
            ]);

            renderChart('accelChart', labels1, [
                { label: 'Accel X', data: feeds1.map(f => f.field3), borderColor: '#fb7185', pointRadius: 1, borderWidth: 2, tension: 0.2 },
                { label: 'Accel Y', data: feeds1.map(f => f.field4), borderColor: '#34d399', pointRadius: 1, borderWidth: 2, tension: 0.2 },
                { label: 'Accel Z (G)', data: feeds1.map(f => f.field5), borderColor: '#60a5fa', pointRadius: 2, borderWidth: 2.5, tension: 0.2 }
            ]);
        }

        function renderChart(canvasId, labels, datasets) {
            const ctx = document.getElementById(canvasId).getContext('2d');
            const scales = { 
                x: { grid: { color: 'rgba(51, 65, 85, 0.4)' }, ticks: { font: { size: 11 } } }, 
                y: { grid: { color: 'rgba(51, 65, 85, 0.4)' }, ticks: { font: { size: 11 } } } 
            };
            if(canvasId === 'climateChart') {
                scales.y = { type: 'linear', display: true, position: 'left', grid: { color: 'rgba(51, 65, 85, 0.4)' }, title: { display: true, text: 'Temp (°C)', color: '#fb7185' } };
                scales.y1 = { type: 'linear', display: true, position: 'right', grid: { drawOnChartArea: false }, title: { display: true, text: 'Humidity (%)', color: '#60a5fa' } };
            }
            if (chartInstances[canvasId]) {
                chartInstances[canvasId].data.labels = labels;
                chartInstances[canvasId].data.datasets = datasets;
                chartInstances[canvasId].update('none');
            } else {
                chartInstances[canvasId] = new Chart(ctx, {
                    type: 'line', data: { labels, datasets },
                    options: { 
                        responsive: true, 
                        maintainAspectRatio: false, 
                        interaction: { mode: 'index', intersect: false }, 
